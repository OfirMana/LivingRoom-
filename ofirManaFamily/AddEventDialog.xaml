<Window x:Class="ofirManaFamily.AddEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="260" Width="380"
        Title="Add / Edit event" WindowStartupLocation="CenterOwner">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title -->
        <TextBlock Text="Title:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox   x:Name="TitleBox" Grid.Row="0" Margin="60,0,0,4"/>

        <!-- date + time pickers -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Start:" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDate" Width="120" Margin="4,0"/>
            <TextBox    x:Name="StartTime" Width="60"  Margin="4,0"
                        ToolTip="HH:mm" Text="12:00"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="End:" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDate" Width="120" Margin="27,0"/>
            <TextBox    x:Name="EndTime" Width="60"  Margin="4,0"
                        ToolTip="HH:mm" Text="13:00"/>
        </StackPanel>

        <!-- description -->
        <TextBlock Text="Description:" Grid.Row="3"/>
        <TextBox   x:Name="DescriptionBox" Grid.Row="3" Margin="0,4,0,4"/>

        <!-- buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK"   Width="70" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>