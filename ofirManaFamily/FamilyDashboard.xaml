<Page x:Class="ofirManaFamily.FamilyDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ofirManaFamily"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FamilyDashboard">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tasks Section -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" Background="White">
            <StackPanel>
                <TextBlock Text="📝 Family Tasks"
                       FontSize="20" FontWeight="Bold" Margin="10,10,10,5"
                       Cursor="Hand" MouseDown="TasksTitle_Click"/>
                <ListBox x:Name="TasksList" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsDone}" Margin="5"/>
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Shopping List Section -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" Background="White">
            <StackPanel>
                <TextBlock Text="🛒 Shopping List"
                       FontSize="20" FontWeight="Bold" Margin="10,10,10,5"
                       Cursor="Hand" MouseDown="ShoppingTitle_Click"/>
                <ListBox x:Name="ShoppingList" Margin="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Purchased, Mode=TwoWay}" Margin="5"/>
                                <TextBlock Text="{Binding ItemName}" VerticalAlignment="Center"/>
                                <TextBlock Text=" x " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Polls Section -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" Background="White">
            <StackPanel>
                <TextBlock Text="📊 Latest Family Poll"
                       FontSize="20" FontWeight="Bold" Margin="10,10,10,5"
                       Cursor="Hand" MouseDown="PollsTitle_Click"/>
                <TextBlock x:Name="LatestPoll" Text="No recent poll found" Margin="10,0,10,10" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Calendar Section -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" Background="White">
            <StackPanel>
                <TextBlock Text="📅 Weekly Calendar"
                       FontSize="20" FontWeight="Bold" Margin="10,10,10,5"
                       Cursor="Hand" MouseDown="CalendarTitle_Click"/>
                <TextBlock Text="(Calendar goes here)" Margin="10" Foreground="Gray" FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>


</Page>
