<Page x:Class="ofirManaFamily.ForgotPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ForgotPasswordPage">

    <Grid Background="#FFEDF4FF">
        <Border Width="400" Padding="20" CornerRadius="20"
                Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TabControl>

                <!-- TAB 1: Reset Member Password -->
                <TabItem Header="איפוס סיסמת משתמש">
                    <StackPanel Margin="10">

                        <TextBlock Text="מספר משפחה (ID)" />
                        <TextBox x:Name="FamIdBox_User" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="סיסמת משפחה" />
                        <PasswordBox x:Name="FamPassBox_User" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="שם משתמש" />
                        <TextBox x:Name="UserNameBox_User" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="סיסמה חדשה" />
                        <PasswordBox x:Name="NewPassBox_User" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="אימות סיסמה" />
                        <PasswordBox x:Name="ConfirmPassBox_User" Height="30" Margin="0,4,0,20"/>

                        <Button Content="אפס סיסמת משתמש"
                                Click="ChangeMemberPassword_Click"
                                Background="#5D4C9A" Foreground="White"
                                FontWeight="Bold" Height="35"/>
                    </StackPanel>
                </TabItem>

                <!-- TAB 2: Reset Family Password -->
                <TabItem Header="איפוס סיסמת משפחה">
                    <StackPanel Margin="10">

                        <TextBlock Text="מספר משפחה (ID)" />
                        <TextBox x:Name="FamIdBox_Fam" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="שם משתמש של בן משפחה" />
                        <TextBox x:Name="UserNameBox_Fam" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="סיסמת המשתמש" />
                        <PasswordBox x:Name="UserPassBox_Fam" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="סיסמה חדשה למשפחה" />
                        <PasswordBox x:Name="NewPassBox_Fam" Height="30" Margin="0,4,0,10"/>

                        <TextBlock Text="אימות סיסמה חדשה" />
                        <PasswordBox x:Name="ConfirmPassBox_Fam" Height="30" Margin="0,4,0,20"/>

                        <Button Content="אפס סיסמת משפחה"
                                Click="ChangeFamilyPassword_Click"
                                Background="#5D4C9A" Foreground="White"
                                FontWeight="Bold" Height="35"/>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Page>