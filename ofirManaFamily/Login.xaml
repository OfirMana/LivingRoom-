<Page x:Class="ofirManaFamily.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ofirManaFamily"
      Title="Login" Background="#FFEDF4FF">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B3C7F9" Offset="0"/>
                <GradientStop Color="#EED9F8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="350" Height="380" CornerRadius="20"
                Background="White" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="כניסת משתמשים" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"
                           TextAlignment="Center" Foreground="#5D4C9A" />

                <TextBlock Text="שם משתמש" HorizontalAlignment="Right" Margin="0,0,10,2"/>
                <TextBox x:Name="textBox" Height="30" FontSize="14" HorizontalAlignment="Stretch" />

                <TextBlock Text="סיסמה" HorizontalAlignment="Right" Margin="0,10,10,2"/>
                <PasswordBox x:Name="passwordBox" Height="30" FontSize="14" HorizontalAlignment="Stretch" />
                <TextBox x:Name="visiblePasswordBox" Height="30" FontSize="14" Visibility="Collapsed"
                         HorizontalAlignment="Stretch" />

                <CheckBox x:Name="showPasswordCheckBox" Content="הצג סיסמה" Margin="0,5,0,0"
                          Checked="ShowPasswordCheckBox_Checked" Unchecked="ShowPasswordCheckBox_Unchecked"
                          HorizontalAlignment="Left"/>

                <TextBlock x:Name="textBlock" Foreground="Red" Visibility="Collapsed"
                           Margin="0,10,0,0" TextAlignment="Center" />

                <Button x:Name="send" Content="כניסה" Click="Button_Click"
                        Background="#5D4C9A" Foreground="White"
                        FontWeight="Bold" Height="35" Width="120"
                        HorizontalAlignment="Center" Margin="0,20,0,0"
                        Cursor="Hand" />

                <Button Content="אין לך משתמש? לחץ כאן"
                        Click="Register_Click"
                        HorizontalAlignment="Center" Background="Transparent"
                        BorderThickness="0" Foreground="DarkBlue" FontWeight="Bold"
                        Margin="0,10,0,0" Cursor="Hand"/>
                <!-- somewhere under your “אין לך משתמש?” button: -->
                <Button Content="?שכחת סיסמה" 
        Click="ForgotPassword_Click"
        HorizontalAlignment="Center"
        Background="Transparent"
        BorderThickness="0"
        Foreground="ForestGreen"
        FontWeight="Bold"
        Cursor="Hand"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
