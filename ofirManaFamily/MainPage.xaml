<Page x:Class="ofirManaFamily.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:HamburgerMenu="clr-namespace:HamburgerMenu;assembly=HamburgerMenu"
      xmlns:local="clr-namespace:ofirManaFamily"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <HamburgerMenu:HamburgerMenu x:Name="MyMenu" Background="LightBlue" MenuIconColor="White" SelectionIndicatorColor="Pink" MenuItemForeground="Black" HorizontalAlignment="Left" Grid.Column="0" MaxWidth="120" >
            <!--<HamburgerMenu:HamburgerMenu.Background>
         <ImageBrush ImageSource="Assets\mountain.jpeg" Stretch="None"/>
     </HamburgerMenu:HamburgerMenu.Background>-->
            <HamburgerMenu:HamburgerMenu.Content>
                <HamburgerMenu:HamburgerMenuItem x:Name="Dummy" Text="Dummy" Visibility="Collapsed" />
                <HamburgerMenu:HamburgerMenuItem Icon="Assets/home.png" Text="Home" Selected="HomeItem_Selected" SelectionCommand="{Binding ElementName=this_}" />
                <!--<HamburgerMenu:HamburgerMenuItem Icon="Assets/search.png" Text="Member List" Selected="Item1_Selected" SelectionCommand="{Binding ElementName=this_}" />-->

                <!-- ✅ New Dashboard Item --><!--
                <HamburgerMenu:HamburgerMenuItem Icon="Assets/dashboard.png" Text="Dashboard" Selected="DashboardItem_Selected" SelectionCommand="{Binding ElementName=this_}" />-->

                <!--<HamburgerMenu:HamburgerMenuItem Icon="Assets/favorite.png" Text="Page2" Selected="Item2_Selected" SelectionCommand="{Binding ElementName=this_}" />-->
                <HamburgerMenu:HamburgerMenuItem x:Name="Backward" Icon="Assets/Left.png" Text="Backward" Selected="HamburgerMenuItem_Selected_3" SelectionCommand="{Binding ElementName=this_}" />
                <HamburgerMenu:HamburgerMenuItem x:Name="Forward" Icon="Assets/Right.png" Text="Forward" Selected="HamburgerMenuItem_Selected_4" SelectionCommand="{Binding ElementName=this_}" />
            </HamburgerMenu:HamburgerMenu.Content>
        </HamburgerMenu:HamburgerMenu>

        <Frame x:Name="myFrame" Grid.Column="1" Source="HomePage.xaml"  />
        <!--<Frame x:Name="myFrame" Grid.Column="1" Source="Home.xaml" NavigationUIVisibility="Hidden" />-->
    </Grid>
</Page>
