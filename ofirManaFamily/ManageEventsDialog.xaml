<Window x:Class="ofirManaFamily.ManageEventsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Events"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="10">

        <!-- ─── Action Buttons Above the List ─── -->
        <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,0,10">
            <Button Content="Refresh"
              Width="80"
              Margin="0,0,6,0"
              Click="Refresh_Click" />

            <Button Content="Finished Editing"
              Width="120"
              Margin="0,0,6,0"
              Click="Done_Click" />

            <Button Content="Close"
              Width="80"
              Click="Close_Click" />
        </StackPanel>

        <!-- ─── Events DataGrid ─── -->
        <DataGrid x:Name="EventsGrid"
              ItemsSource="{Binding Events}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              Margin="0,0,0,0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Title"
                            Binding="{Binding EventName}"
                            Width="*" />
                <DataGridTextColumn Header="Start"
                            Binding="{Binding EventStartDate, StringFormat=yyyy-MM-dd HH:mm}"
                            Width="160" />
                <DataGridTextColumn Header="End"
                            Binding="{Binding EventEndDate,   StringFormat=yyyy-MM-dd HH:mm}"
                            Width="160" />

                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Center">
                                <Button Content="✏️"
                        ToolTip="Edit"
                        Padding="4,2"
                        Click="EditEvent_Click"
                        Tag="{Binding}" />
                                <Button Content="🗑️"
                        ToolTip="Delete"
                        Padding="4,2"
                        Click="DeleteEvent_Click"
                        Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>