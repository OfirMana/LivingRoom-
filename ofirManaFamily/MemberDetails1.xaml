<Page x:Class="ofirManaFamily.MemberDetails1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Member Details">

    <!-- 1. רקע תואם דף־התחברות -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B3C7F9" Offset="0"/>
                <GradientStop Color="#EED9F8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 2. כרטיס ממורכז -->
        <Border Width="400" Padding="24" CornerRadius="16"
                Background="White" HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- כותרת -->
                <TextBlock Text="הוספת/עריכת משתמש"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#5D4C9A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- שם־משתמש -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="שם משתמש:" Width="100" VerticalAlignment="Center"/>
                    <TextBox  Text="{Binding UserName}"
                              Width="250" Height="32" Padding="4"/>
                </StackPanel>

                <!-- סיסמה -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="סיסמא:" Width="100" VerticalAlignment="Center"/>
                    <TextBox  Text="{Binding Passwordd}"
                              Width="250" Height="32" Padding="4"/>
                </StackPanel>

                <!-- שם פרטי -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="שם פרטי:" Width="100" VerticalAlignment="Center"/>
                    <TextBox  Text="{Binding MemberName}"
                              Width="250" Height="32" Padding="4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="מנהל"
                              IsChecked="{Binding IsManager}" Checked="CheckBox_Checked"
                              />
                </StackPanel>

                <!-- מנהל (Role הוסר) -->

                <!-- תאריך לידה -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="תאריך לידה:" Width="100" VerticalAlignment="Center"/>
                    <DatePicker x:Name="birthDatePicker"
                                SelectedDate="{Binding BirthDate}"
                                DisplayDateStart="1900-01-01"
                                DisplayDate="{x:Static sys:DateTime.Today}"
                                IsTodayHighlighted="True"
                                Width="250" Height="32"/>
                </StackPanel>

                <!-- משפחה (קריאה בלבד) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <TextBlock Text="משפחה:" Width="100" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Family.FamilyName}"
                               Width="250"
                               VerticalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="#666"/>
                </StackPanel>

                <!-- כפתור שמירה -->
                <Button Content="שמור"
                        Click="BackButton_Click"
                        Width="120" Height="36"
                        Background="#5D4C9A"
                        Foreground="White"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>