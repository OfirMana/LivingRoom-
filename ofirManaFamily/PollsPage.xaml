<Page x:Class="ofirManaFamily.PollsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PollsPage">

    <Grid Background="#f9f9fb">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🛈 כפתור מידע בפינה -->
        <Button x:Name="InfoBtn"
            Width="28" Height="28"
            FontSize="18" FontWeight="Bold"
            Content="?"
            ToolTip="לחץ להסבר על סקרים"
            Click="InfoBtn_Click"
            Background="#5D4C9A" Foreground="White"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="10"
            Cursor="Hand"/>

        <!-- Collapsible Create Poll Section -->
        <Expander Grid.Row="0" Margin="20" Header="Create a New Poll" IsExpanded="False">
            <Border Padding="15" Background="White" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Question:" FontWeight="Bold"/>
                    <TextBox x:Name="NewPollQuestionBox" Margin="0 0 0 8"/>
                    <TextBlock Text="Description (optional):" FontWeight="Bold"/>
                    <TextBox x:Name="NewPollDescriptionBox" Margin="0 0 0 8"/>
                    <TextBlock Text="Options:" FontWeight="Bold"/>
                    <ItemsControl x:Name="PollOptionsInputPanel" Margin="0 0 0 8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Option" Click="AddOption_Click" Margin="0 0 8 0"/>
                        <Button Content="Create Poll" Click="CreatePoll_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Polls List -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PollsPanel"/>
        </ScrollViewer>
    </Grid>
</Page>
