<Page x:Class="ofirManaFamily.ShoppingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sysctrl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
      Title="ShoppingPage">

    <Page.Resources>
        <!-- Comic Sans for fun -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>

        <!-- built-in converter -->
        <sysctrl:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Border Background="#FFFFFFAA" CornerRadius="15" Padding="20" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ❓ info -->
            <Button x:Name="InfoBtn"
                    Content="?" FontSize="18" FontWeight="Bold"
                    Width="28" Height="28"
                    Background="#5D4C9A" Foreground="White"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,4,4"
                    Click="InfoBtn_Click"/>

            <TextBlock Text="🛒 Shopping List" FontSize="16" Margin="0,32,0,10"/>

            <!-- list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ShoppingItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">

                                <!-- ✔ bought mark -->
                                <CheckBox Tag="{Binding}"
                                          IsChecked="{Binding Purchased}"
                                          Checked="Check_Checked"
                                          Unchecked="Check_Checked"
                                          Margin="0,0,6,0"/>

                                <!-- 🗑 delete (manager only) -->
                                <Button Content="🗑" Width="26" Height="26"
                                        Tag="{Binding}"
                                        Click="DeleteBtn_Click"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding DataContext.IsManager,
                                                             RelativeSource={RelativeSource AncestorType=Page},
                                                             Converter={StaticResource BoolToVis}}"/>

                                <!-- item text -->
                                <TextBlock Text="{Binding ItemName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Purchased}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding Quantity}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- add area -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Item Name" FontSize="12"/>
                    <TextBox x:Name="ItemNameTextBox" Width="200"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Quantity" FontSize="12"/>
                    <TextBox x:Name="QuantityTextBox" Width="80"/>
                </StackPanel>

                <Button Content="Add" Click="AddButton_Click" VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
