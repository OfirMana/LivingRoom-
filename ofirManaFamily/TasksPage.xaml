<Page x:Class="ofirManaFamily.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sysctrl="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
      Title="TasksPage">

    <!-- ───── Resources ───── -->
    <Page.Resources>
        <!-- Comic Sans for all text -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
        </Style>

        <!-- built-in converter → no code-behind file -->
        <sysctrl:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- tiny fade when navigating away (optional) -->
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>

    <!-- ───── Layout ───── -->
    <Border Background="#FFFFFFAA" CornerRadius="15" Padding="20" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ❓ info button -->
            <Button x:Name="InfoBtn"
                    Content="?" FontSize="18" FontWeight="Bold"
                    Width="28" Height="28"
                    Background="#5D4C9A" Foreground="White"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,0,4,4"
                    Cursor="Hand"
                    ToolTip="לחץ להסבר על ניהול משימות"
                    Click="InfoBtn_Click"/>

            <!-- title -->
            <TextBlock Text="✅ Tasks (checked = done)"
                       FontSize="16"
                       Margin="0,32,0,10"/>

            <!-- task list -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TasksItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">

                                <!-- first row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">

                                    <!-- ✔ done toggle -->
                                    <Button Content="✔"
                                            Tag="{Binding}"
                                            Click="CompleteBtn_Click"
                                            Width="26" Height="26"
                                            Margin="0,0,6,0"/>

                                    <!-- 🗑 delete (manager only) -->
                                    <Button Content="🗑"
                                            Tag="{Binding}"
                                            Click="DeleteBtn_Click"
                                            Width="26" Height="26"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding DataContext.IsManager,
                                                                 RelativeSource={RelativeSource AncestorType=Page},
                                                                 Converter={StaticResource BoolToVis}}"/>

                                    <!-- name | deadline -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TaskName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" | "/>
                                        <TextBlock Text="{Binding TaskDeadline,
                                                                  StringFormat={}{0:dd/MM/yyyy}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- instructions -->
                                <TextBlock Text="{Binding TaskInstructions}"
                                           FontSize="12" Foreground="Gray"
                                           Margin="32,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- add-task input -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Task Name"/>
                    <TextBox x:Name="TaskNameTextBox" Width="150"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Deadline"/>
                    <DatePicker x:Name="TaskDeadlinePicker" Width="150"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Instructions"/>
                    <TextBox x:Name="InstructionsTextBox" Width="200"/>
                </StackPanel>

                <Button Content="Add"
                        Click="AddButton_Click"
                        VerticalAlignment="Bottom"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>